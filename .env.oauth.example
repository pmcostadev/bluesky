# ---------- OAuth mode (lets other people connect their own Bluesky account) ----------

# Public https origin of this deployment. Required: it forms the client_id.
OAUTH_PUBLIC_ORIGIN=https://bluesky.pmcosta.dev

# Random string, 32+ chars. Encrypts the tokens this server issues.
OAUTH_SIGNING_SECRET=

# Optional. Scopes requested from the user's PDS.
# transition:chat.bsky is what makes the DM tools work.
BLUESKY_SCOPE=atproto transition:generic transition:chat.bsky

# ---------- Signing keys: confidential client, 180-day sessions ----------
# ES256 (EC P-256) private keys as single-line JWK JSON. Set at least one.
#
# With none of these set, the server registers as a PUBLIC client and Bluesky
# caps every session at 14 days, so users have to reconnect every fortnight.
# With them set, it authenticates to the token endpoint with a signed assertion
# (private_key_jwt) and refresh tokens last up to 180 days.
#
# Key 2 and 3 are optional and exist for rotation: publish the new key, wait for
# PDSes to re-fetch /jwks.json, then remove the old one.
BLUESKY_PRIVATE_KEY_1=
BLUESKY_PRIVATE_KEY_2=
BLUESKY_PRIVATE_KEY_3=

# ---------- Session storage (required for OAuth) ----------
# Provided automatically when you add a Redis/KV store to the Vercel project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Composio connect flow (for /connect.js and /api/connect/*) ----------
# Needed only if your product starts connections itself instead of using the
# Composio dashboard.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=

# Default user id when the caller does not pass one.
COMPOSIO_USER_ID=default

# Comma-separated origins allowed to call /api/connect/*. Unset means any
# origin, which is fine while testing and too loose in production.
CONNECT_ALLOWED_ORIGINS=
