# ---------- OAuth mode (lets other people connect their own Bluesky account) ----------

# Public https origin of this deployment. Required: it forms the client_id.
OAUTH_PUBLIC_ORIGIN=https://bluesky.pmcosta.dev

# Base64-encoded ES256 private key in JWK form. Signs client assertions.
BLUESKY_PRIVATE_KEY=

# Random string, 32+ chars. Encrypts the tokens this server issues.
OAUTH_SIGNING_SECRET=

# Optional. Scopes requested from the user's PDS.
BLUESKY_SCOPE=atproto transition:generic

# ---------- Session storage (required for OAuth) ----------
# Provided automatically when you add a Redis/KV store to the Vercel project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
