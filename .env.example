# Bluesky MCP Server - environment variables
# ==========================================
# Copy to .env.local for development. Never commit real values.
#
# This server authenticates with AT Protocol OAuth only. App passwords are not
# accepted: there is no identifier/password variable, and no request header
# carrying one.

# ---------- Required ----------

# Public https origin of this deployment. It forms the OAuth client_id, so it
# must match the domain users actually reach.
OAUTH_PUBLIC_ORIGIN=https://your-domain.example

# Random string, 32+ chars. Encrypts the tokens this server issues.
#   openssl rand -base64 32
OAUTH_SIGNING_SECRET=

# Session storage. Provided automatically when a Redis/KV store is attached to
# the Vercel project; atproto refresh tokens are single-use, so they need real
# storage rather than a cookie.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Signing keys: confidential client, 180-day sessions ----------
# ES256 (EC P-256) private keys as single-line JWK JSON. Optional but strongly
# recommended: without them the server registers as a PUBLIC client and Bluesky
# caps every session at 14 days. Keys 2 and 3 exist for rotation.
#
# Generate one with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});const j=privateKey.export({format:'jwk'});j.alg='ES256';j.kid='bsky-1';console.log(JSON.stringify(j))"
BLUESKY_PRIVATE_KEY_1=
BLUESKY_PRIVATE_KEY_2=
BLUESKY_PRIVATE_KEY_3=

# ---------- Optional ----------

# Scopes requested from the user's PDS. transition:chat.bsky enables DMs.
BLUESKY_SCOPE=atproto transition:generic transition:chat.bsky

# Where to send users who do not supply a handle. Almost every account lives on
# bsky.social, and sending them straight there removes the handle prompt.
BLUESKY_DEFAULT_PDS=https://bsky.social

# Enables the administrative diagnostics at /api/oauth/session. Unset means that
# endpoint is disabled. Use a random value unrelated to OAUTH_SIGNING_SECRET.
ADMIN_TOKEN=

# ---------- Composio connect flow (optional) ----------
# Only needed if your own product starts connections through /api/connect/*
# instead of the Composio dashboard.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=
COMPOSIO_USER_ID=default

# Comma-separated origins allowed to call /api/connect/*. Leaving this unset
# lets ANY site ask this deployment to create a connection on your Composio
# account. Set it in production.
CONNECT_ALLOWED_ORIGINS=
